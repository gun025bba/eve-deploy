#!/bin/bash
# eve-deploy entry point. Runs as an ordinary (non-root, non-admin) user.
#
#   deploy deploy   gateway|web VERSION [--from DIR]   install release VERSION of a component (default: download it from the GitHub release)
#   deploy rollback gateway|web                        go back to the one previous version
#
# Gateway installs the release under $EVE_RELEASE_ROOT/releases/<ver>/bin/ and asks eve-supervisor
# (control socket) to deploy or roll back. The supervisor swaps pointers, restarts, checks health
# and /_deploy/version, and rolls back itself. This script only records the supervisor's result.
# Web is still a file tree swap (no process to restart).
# Exit 0 = the requested version (or, for rollback, the previous one) is live and healthy. The outcome
# is written to $EVE_ROOT/state/result.json and, in CI, to the job summary.
# Integrity: sha256 of the tarball only (a transport check, not a signature). Written for macOS /bin/bash 3.2 and BSD tools.
set -uo pipefail
export LC_ALL=C

EVE_ROOT=${EVE_ROOT:-/opt/eve-gw}
EVE_RELEASE_ROOT=${EVE_RELEASE_ROOT:-/opt/eve-gw/deploy}                 # supervisor release_root (releases/<ver>/bin/... lives under it)
EVE_CONTROL_SOCKET=${EVE_CONTROL_SOCKET:-/opt/eve-gw/run/supervisor.sock} # directory of this socket must be 0700 and owned by this user
EVE_SUPERVISOR_CHILDREN=${EVE_SUPERVISOR_CHILDREN:-gateway}              # supervisor child names; one "deploy <child> <ver>" per name
EVE_OWNER=${EVE_OWNER:-gun025bba}
EVE_REPO_GATEWAY=${EVE_REPO_GATEWAY:-eve-serving}
EVE_REPO_WEB=${EVE_REPO_WEB:-eve-web}
EVE_UI_URL=${EVE_UI_URL:-http://127.0.0.1:8000/ui/}
EVE_HEALTH_WAIT=${EVE_HEALTH_WAIT:-90}        # seconds the new web tree has to become healthy
EVE_FETCH_RETRIES=${EVE_FETCH_RETRIES:-5}
RELEASE_BINS="eve-gw eve-service eve-supervisor eve-admin"

WEB=$EVE_ROOT/web; ST=$EVE_ROOT/state
PREV_WEB=$EVE_ROOT/previous/web

now() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log() { printf '%s %s\n' "$(now)" "$*" | tee -a "$ST/deploy.log" 2>/dev/null; }
summary() { [ -n "${GITHUB_STEP_SUMMARY:-}" ] && printf '%s\n' "$*" >>"$GITHUB_STEP_SUMMARY"; return 0; }
STARTED=$(now); COMPONENT=""; FROM_V=""; TO_V=""; STATUS=failed; HEALTH=unknown
write_result() {
  mkdir -p "$ST" 2>/dev/null || return 0
  printf '{"component":"%s","from":"%s","to":"%s","status":"%s","started_at":"%s","finished_at":"%s","health":"%s"}\n' \
    "$COMPONENT" "$FROM_V" "$TO_V" "$STATUS" "$STARTED" "$(now)" "$HEALTH" >"$ST/result.json.tmp" && mv -f "$ST/result.json.tmp" "$ST/result.json"
  summary "### eve-deploy: $COMPONENT $FROM_V -> $TO_V: **$STATUS** (health: $HEALTH)"
}
die() { log "FAIL: $*"; printf 'deploy: %s\n' "$*" >&2; write_result; exit 1; }

valid_version() { [[ "$1" =~ ^(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$ ]]; }
sha_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi; }
cur_version() { cat "$ST/$1.version" 2>/dev/null || true; }
prev_version() { cat "$ST/$1.previous" 2>/dev/null || true; }
json_get() { sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$1" | head -1; }
json_bool() { sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\\(true\\|false\\).*/\\1/p" "$1" | head -1; }
file_mode() { # permission bits without the leading zero (700)
  local m; if [ "$(uname -s)" = Darwin ]; then m=$(stat -f '%Lp' "$1"); else m=$(stat -c '%a' "$1"); fi
  printf '%s\n' "${m#0}"
}
file_uid() { if [ "$(uname -s)" = Darwin ]; then stat -f '%u' "$1"; else stat -c '%u' "$1"; fi; }

# ----- web health -----
http_ok() { curl -fsS -m 5 -o /dev/null "$1" 2>/dev/null; }
wait_healthy() { # $1 component (web)
  local i=0
  [ "$1" = web ] || return 1
  while [ "$i" -lt "$EVE_HEALTH_WAIT" ]; do
    http_ok "$EVE_UI_URL" && return 0
    i=$((i + 1)); sleep 1
  done
  return 1
}

# ----- supervisor control socket (protocol of eve-serving internal/supervisor/control.go) -----
# One JSON request {"command","child","version"} per connection, one JSON result.
# The socket directory is the boundary: it must be a real directory, mode 0700, owned by this user.
supervisor_call() { # $1 command $2 child $3 version (deploy only)
  local sock dir mode uid
  sock=$EVE_CONTROL_SOCKET; dir=$(dirname "$sock")
  [ -L "$dir" ] && die "control socket directory is a symlink"
  [ -d "$dir" ] || die "control socket directory is missing ($dir)"
  mode=$(file_mode "$dir"); uid=$(file_uid "$dir")
  [ "$mode" = 700 ] || die "control socket directory must be private (0700), found $mode"
  [ "$uid" = "$(id -u)" ] || die "control socket directory must be owned by this user"
  [ -L "$sock" ] && die "control socket path is a symlink"
  [ -S "$sock" ] || die "control socket is not available ($sock)"
  command -v python3 >/dev/null 2>&1 || die "python3 is required to talk to the supervisor control socket"
  log "supervisor $1 $2${3:+ $3}"
  python3 - "$sock" "$1" "$2" "${3:-}" >"$ST/supervisor.last" <<'PY' || die "supervisor control call failed"
import json, socket, sys
path, cmd, child, ver = sys.argv[1:5]
req = {"command": cmd, "child": child}
if cmd == "deploy":
    req["version"] = ver
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect(path)
    s.sendall((json.dumps(req) + "\n").encode())
    data = b""
    while len(data) < (1 << 20):
        b = s.recv(4096)
        if not b:
            break
        data += b
except OSError as e:
    sys.stderr.write("supervisor socket: %s\n" % e)
    sys.exit(1)
finally:
    s.close()
if not data.strip():
    sys.exit(1)
sys.stdout.write(data.decode())
PY
  [ -s "$ST/supervisor.last" ] || die "supervisor returned an empty result"
}

# $1 result file, $2 1 when any sibling rollback also succeeded
apply_failed() {
  local rb rh
  rb=$(json_bool "$1" rolled_back); rh=$(json_bool "$1" rollback_healthy)
  log "supervisor: $(json_str_file "$1" error)"
  if [ "$rb" = true ] && [ "$2" = 1 ]; then
    STATUS=rolled-back
    if [ "$rh" = true ]; then HEALTH=restored; else HEALTH=restore-failed; fi
  elif [ "$rb" = true ]; then
    STATUS=rolled-back; HEALTH=restore-failed
  else
    STATUS=failed; HEALTH=unhealthy
    [ "$2" = 1 ] || HEALTH=restore-failed
  fi
}
json_str_file() { json_get "$1" "$2"; }

# Deploy each child. The supervisor rolls a failed child back itself; children already
# switched in this call are rolled back here so a release does not stay half-applied.
deploy_children() { # $1 version
  local child ok err rev c restored
  SUPER_DONE=""
  for child in $EVE_SUPERVISOR_CHILDREN; do
    supervisor_call deploy "$child" "$1"
    ok=$(json_bool "$ST/supervisor.last" ok); err=$(json_get "$ST/supervisor.last" error)
    if [ "$ok" = true ]; then SUPER_DONE="$SUPER_DONE $child"; continue; fi
    if [ "$err" = "version is already current" ]; then continue; fi
    cp "$ST/supervisor.last" "$ST/supervisor.failed" || die "cannot record the supervisor result"
    rev=""; for c in $SUPER_DONE; do rev="$c $rev"; done
    restored=1
    for c in $rev; do
      supervisor_call rollback "$c" || restored=0
      [ "$(json_bool "$ST/supervisor.last" ok)" = true ] || restored=0
    done
    apply_failed "$ST/supervisor.failed" "$restored"
    return 1
  done
  if [ -z "$SUPER_DONE" ]; then STATUS=unchanged; HEALTH=ok; return 0; fi
  STATUS=success; HEALTH=ok; return 0
}
rollback_children() {
  local child rev="" ok err
  for child in $EVE_SUPERVISOR_CHILDREN; do rev="$child $rev"; done
  for child in $rev; do
    supervisor_call rollback "$child"
    ok=$(json_bool "$ST/supervisor.last" ok); err=$(json_get "$ST/supervisor.last" error)
    if [ "$ok" != true ]; then log "supervisor: $err"; STATUS=failed; HEALTH=unhealthy; return 1; fi
  done
  STATUS=success; HEALTH=ok; return 0
}

# ----- fetch + verify -----
fetch_release() { # $1 component $2 version $3 outdir
  local repo base asset f
  if [ "$1" = gateway ]; then repo=$EVE_REPO_GATEWAY; asset="eve-gateway-$2-darwin-arm64"; else repo=$EVE_REPO_WEB; asset="eve-web-$2"; fi
  base="https://github.com/$EVE_OWNER/$repo/releases/download/v$2"
  for f in "$asset.tar.gz" "$asset.tar.gz.sha256" manifest.json; do
    curl -fsSL --proto '=https' --tlsv1.2 --retry "$EVE_FETCH_RETRIES" --retry-delay 3 --retry-all-errors -o "$3/$f" "$base/$f" || { [ "$f" = manifest.json ] && { rm -f "$3/$f"; continue; }; return 1; }   # manifest.json is optional (a release made by hand has none)
  done
  printf '%s' "$asset"
}
verify_release() { # $1 component $2 version $3 dir $4 asset
  local want got
  want=$(awk '{print $1; exit}' "$3/$4.tar.gz.sha256"); got=$(sha_of "$3/$4.tar.gz")
  [[ "$want" =~ ^[0-9a-f]{64}$ ]] && [ "$want" = "$got" ] || return 1
  if [ -f "$3/manifest.json" ]; then [ "$(json_get "$3/manifest.json" component)" = "$1" ] && [ "$(json_get "$3/manifest.json" version)" = "$2" ] || return 2; fi
  if tar -tzf "$3/$4.tar.gz" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then return 3; fi
  if tar -tvzf "$3/$4.tar.gz" | grep -Eq '^[lh]'; then return 3; fi      # no symlinks or hard links inside a release
  return 0
}

# Place the four binaries where the supervisor verifies them: release_root/releases/<ver>/<executable>.
# Directories are 0700 and binaries are owner-executable and not group/other writable, so verifyRelease passes.
install_release() { # $1 unpacked dir $2 version
  local rel="$EVE_RELEASE_ROOT/releases/$2/bin" f
  mkdir -p "$rel" || return 1
  chmod 700 "$EVE_RELEASE_ROOT" "$EVE_RELEASE_ROOT/releases" "$EVE_RELEASE_ROOT/releases/$2" "$rel" || return 1
  for f in $RELEASE_BINS; do
    [ -f "$1/$f" ] && [ ! -L "$1/$f" ] || return 1
    cp "$1/$f" "$rel/$f.new" && chmod 700 "$rel/$f.new" && mv -f "$rel/$f.new" "$rel/$f" || return 1
  done
}

# ----- web tree swap (unchanged: the UI is files, not a supervised process) -----
# The web tree is swapped IN PLACE: $WEB itself stays where it is and only its contents move. $EVE_ROOT is owned by root, so the
# deploy user can not rename $WEB (that needs write access to its parent), but it owns $WEB and $EVE_ROOT/previous.
# index.html and sw.js are the entry points: they leave first and come back last, so a client never meets a new page with old assets
# (or a new service worker before its files). Every step that can fail has an undo that moves files back and never deletes live files.
empty_dir() { [ -d "$1" ] && find "$1" -mindepth 1 -maxdepth 1 -exec rm -rf {} + ; }
move_contents() { # $1 source dir, $2 destination dir (must not hold the same names), $3 first|last: where index.html + sw.js go; leaves what it could not move in $1
  local e b k; mkdir -p "$2" || return 1
  if [ "${3:-}" = first ]; then for k in index.html sw.js; do [ -e "$1/$k" ] && { [ ! -e "$2/$k" ] && mv "$1/$k" "$2/" || return 1; }; done; fi
  for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [ -e "$e" ] || [ -L "$e" ] || continue; b=${e##*/}
    if [ -n "${3:-}" ]; then case "$b" in index.html|sw.js) continue;; esac; fi
    [ ! -e "$2/$b" ] || return 1
    mv "$e" "$2/" || return 1
  done
  if [ "${3:-}" = last ]; then for k in index.html sw.js; do [ -e "$1/$k" ] && { [ ! -e "$2/$k" ] && mv "$1/$k" "$2/" || return 1; }; done; fi
  return 0
}
web_hint() { # $1 what failed; $2.. the manual commands. Printed only when an automatic undo did not work too.
  local what=$1; shift
  log "MANUAL RECOVERY NEEDED: $what, and putting the files back failed too. Look at: ls -A $WEB $PREV_WEB $EVE_ROOT/previous/web.swap"
  log "  The release that was live belongs in $WEB, the older one in $PREV_WEB (state/web.version says which is which). To put it back by hand:"
  local c; for c in "$@"; do log "    $c"; done
  log "  or redeploy the live release: bash bin/deploy deploy web <version> --from <dir with its tarball>"
}
install_web_tree() { # $1 new tree dir (its contents become $WEB); the old contents become $PREV_WEB; the older previous waits in $PREV_WEB.old until success
  mkdir -p "$EVE_ROOT/previous" "$WEB" || return 1
  rm -rf "$PREV_WEB.old"; [ -d "$PREV_WEB" ] && { mv "$PREV_WEB" "$PREV_WEB.old" || return 1; }
  mkdir -p "$PREV_WEB" || return 1
  if ! move_contents "$WEB" "$PREV_WEB" first; then
    move_contents "$PREV_WEB" "$WEB" last || web_hint "installing web: moving the old files aside failed" "mv $PREV_WEB/* $PREV_WEB/.[!.]* $WEB/"
    rmdir "$PREV_WEB" 2>/dev/null; [ -d "$PREV_WEB.old" ] && mv "$PREV_WEB.old" "$PREV_WEB"; return 1
  fi
  if ! move_contents "$1" "$WEB" last; then
    move_contents "$WEB" "$1" || empty_dir "$WEB"
    move_contents "$PREV_WEB" "$WEB" last || web_hint "installing web: moving the new files in failed" "mv $WEB/* $WEB/.[!.]* $1/   # or delete them" "mv $PREV_WEB/* $PREV_WEB/.[!.]* $WEB/"
    rmdir "$PREV_WEB" 2>/dev/null; [ -d "$PREV_WEB.old" ] && mv "$PREV_WEB.old" "$PREV_WEB"; return 1
  fi
  chmod -R go+rX "$WEB" 2>/dev/null; return 0
}
commit_web_tree() { rm -rf "$PREV_WEB.old"; }
restore_web_tree() { # the new tree failed its health check
  empty_dir "$WEB"
  move_contents "$PREV_WEB" "$WEB" last && rmdir "$PREV_WEB" 2>/dev/null || web_hint "restoring the old web tree failed" "mv $PREV_WEB/* $PREV_WEB/.[!.]* $WEB/"
  [ -d "$PREV_WEB.old" ] && mv "$PREV_WEB.old" "$PREV_WEB"
  return 0
}
rollback_web_tree() { # swap the contents of $WEB and $PREV_WEB through $keep. 0 = swapped; 1 = failed at some step, original state restored; 2 = failed and not restored (hint printed)
  local keep="$EVE_ROOT/previous/web.swap" step=1 hint
  rm -rf "$keep"; mkdir -p "$keep" || return 1
  move_contents "$WEB" "$keep" first || step=-1
  if [ $step = 1 ]; then step=2; move_contents "$PREV_WEB" "$WEB" last || step=-2; fi
  if [ $step = 2 ]; then step=3; move_contents "$keep" "$PREV_WEB" last || step=-3; fi
  if [ $step = 3 ]; then rmdir "$keep" 2>/dev/null; return 0; fi
  step=$((-step))
  log "rollback web: step $step of 3 failed ($(case $step in 1) echo "live files -> $keep";; 2) echo "older files -> $WEB";; 3) echo "kept files -> $PREV_WEB";; esac)): undoing"
  case $step in
    1) move_contents "$keep" "$WEB" last && rmdir "$keep" && return 1
       hint="mv $keep/* $keep/.[!.]* $WEB/";;
    2) move_contents "$WEB" "$PREV_WEB" first && move_contents "$keep" "$WEB" last && rmdir "$keep" && return 1
       hint="mv $WEB/* $WEB/.[!.]* $PREV_WEB/ && mv $keep/* $keep/.[!.]* $WEB/";;
    3) move_contents "$PREV_WEB" "$keep" first && move_contents "$WEB" "$PREV_WEB" first && move_contents "$keep" "$WEB" last && rmdir "$keep" && return 1
       hint="mv $PREV_WEB/* $PREV_WEB/.[!.]* $keep/ && mv $WEB/* $WEB/.[!.]* $PREV_WEB/ && mv $keep/* $keep/.[!.]* $WEB/";;
  esac
  web_hint "rollback web stopped at step $step of 3" "$hint"; return 2
}

# ----- commands -----
do_deploy() { # $1 component $2 version $3 from-dir (may be empty)
  COMPONENT=$1; TO_V=$2; FROM_V=$(cur_version "$1")
  valid_version "$2" || die "bad version '$2'"
  local work asset rc
  mkdir -p "$ST" || die "cannot create $ST"
  work=$(mktemp -d "$ST/work.XXXXXX") || die "cannot create a work dir"
  WORK=$work
  if [ "$FROM_V" = "$2" ]; then STATUS=unchanged; HEALTH=ok; log "$1 $2 is already live: nothing to do"; write_result; return 0; fi
  if [ -n "$3" ]; then
    if [ "$1" = gateway ]; then asset="eve-gateway-$2-darwin-arm64"; else asset="eve-web-$2"; fi
    cp "$3/$asset.tar.gz" "$3/$asset.tar.gz.sha256" "$work/" || die "missing artifact files in $3"; [ -f "$3/manifest.json" ] && cp "$3/manifest.json" "$work/"
  else
    log "downloading $1 $2"
    asset=$(fetch_release "$1" "$2" "$work") || die "download failed for $1 $2 (the release may not exist yet)"
  fi
  verify_release "$1" "$2" "$work" "$asset"; rc=$?
  [ "$rc" = 0 ] || die "artifact check failed (code $rc: 1 sha256, 2 manifest component/version, 3 unsafe tar path)"
  mkdir -p "$work/new" && tar -xzf "$work/$asset.tar.gz" -C "$work/new" || die "cannot unpack the tarball"
  if [ "$1" = gateway ]; then
    local f
    for f in $RELEASE_BINS; do [ -f "$work/new/$f" ] && [ ! -L "$work/new/$f" ] || die "release is missing $f"; done
    [ -x "$work/new/eve-gw" ] || chmod +x "$work/new/eve-gw" 2>/dev/null
    [ "$("$work/new/eve-gw" -version 2>&1)" = "$2" ] || die "the new eve-gw binary does not run here or reports another version"
    log "installing gateway $2 (was ${FROM_V:-none})"
    install_release "$work/new" "$2" || die "cannot install the release files"
    if deploy_children "$2"; then
      if [ "$STATUS" = success ]; then echo "$FROM_V" >"$ST/gateway.previous"; echo "$2" >"$ST/gateway.version"; log "gateway $2 is live"; fi
      if [ "$STATUS" = unchanged ]; then echo "$2" >"$ST/gateway.version"; log "gateway $2 is already current"; fi
      write_result; return 0
    fi
    log "gateway $2 was not activated ($STATUS, health $HEALTH)"
    write_result; exit 1
  else
    log "installing web $2 (was ${FROM_V:-none})"
    install_web_tree "$work/new" || die "cannot install the web tree"
    if wait_healthy web "$2"; then
      HEALTH=ok; STATUS=success; commit_web_tree; echo "$FROM_V" >"$ST/web.previous"; echo "$2" >"$ST/web.version"
      log "web $2 is live"; write_result; return 0
    fi
    log "web $2 failed its health check: restoring ${FROM_V:-the previous tree}"
    restore_web_tree; wait_healthy web "$FROM_V" && HEALTH=restored || HEALTH=restore-failed
    STATUS=rolled-back; log "rolled back ($HEALTH)"; write_result; exit 1
  fi
}

do_rollback() { # $1 component
  COMPONENT=$1; FROM_V=$(cur_version "$1"); TO_V=$(prev_version "$1")
  mkdir -p "$ST" || die "cannot create $ST"
  [ -n "$TO_V" ] || die "no previous $1 version is kept"
  log "rolling $1 back $FROM_V -> $TO_V"
  if [ "$1" = gateway ]; then
    if rollback_children; then echo "$TO_V" >"$ST/gateway.version"; echo "$FROM_V" >"$ST/gateway.previous"; fi
  else
    [ -d "$PREV_WEB" ] || die "no previous web tree is kept"
    rollback_web_tree; rc=$?
    case $rc in 1) die "web rollback failed while moving files; the original web trees were restored";; 2) die "web rollback failed while moving files and the original state could NOT be restored: see MANUAL RECOVERY in $ST/deploy.log";; esac
    if wait_healthy web "$TO_V"; then echo "$TO_V" >"$ST/web.version"; echo "$FROM_V" >"$ST/web.previous"; STATUS=success; HEALTH=ok; else HEALTH=unhealthy; STATUS=failed; fi
  fi
  write_result; [ "$STATUS" = success ]
}

usage() { echo "usage: deploy deploy gateway|web VERSION [--from DIR] | deploy rollback gateway|web" >&2; exit 2; }
[ $# -ge 2 ] || usage
CMD=$1; COMP=$2; shift 2
case "$COMP" in gateway|web) ;; *) usage;; esac
mkdir -p "$ST" 2>/dev/null
LOCK=$ST/lock
mkdir "$LOCK" 2>/dev/null || { if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +30 2>/dev/null)" ]; then rm -rf "$LOCK"; mkdir "$LOCK" || usage; else echo "deploy: another deploy is running" >&2; exit 1; fi; }
WORK=""
cleanup() { [ -n "$WORK" ] && rm -rf "$WORK"; rmdir "$LOCK" 2>/dev/null; return 0; }
trap cleanup EXIT
case "$CMD" in
  deploy)
    [ $# -ge 1 ] || usage; VER=$1; shift; FROMDIR=""
    if [ "${1:-}" = "--from" ]; then FROMDIR=${2:-}; [ -d "$FROMDIR" ] || usage; fi
    do_deploy "$COMP" "$VER" "$FROMDIR";;
  rollback) do_rollback "$COMP";;
  *) usage;;
esac
